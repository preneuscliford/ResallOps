NEXT_PUBLIC_APP_NAME="ResallOps Radar"
NEXT_PUBLIC_SUPABASE_URL="https://qtuicqazbsdahttpbuju.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Protege l'acces a toute l'application (Basic Auth). Definissez les deux
# variables en production, sinon l'application reste ouverte a tous.
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""

# Cles de votre application sur developer.ebay.com (Browse API).
# Sans ces variables, la synchro eBay renvoie une erreur explicite au lieu
# d'echouer silencieusement.
# EBAY_ENV="sandbox" pointe vers l'environnement de test d'eBay (donnees
# fictives, aucune vraie annonce) : pratique pour valider le cablage avant
# d'avoir des cles Production, mais ne jamais synchroniser en sandbox vers
# une base Supabase de production. Mettre "production" (ou omettre) une
# fois les cles Production obtenues.
EBAY_ENV="production"
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
